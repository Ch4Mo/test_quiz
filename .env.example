# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# Clé publique (anon / "publishable") : utilisée par le navigateur pour le temps réel et l'upload signé
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé secrète (service_role / "secret") : utilisée uniquement côté serveur. Ne jamais l'exposer.
SUPABASE_SERVICE_ROLE_KEY=

# Mot de passe de la console admin et de l'écran de jeu
ADMIN_PASSWORD=change-moi
